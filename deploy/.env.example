# Copy to .env on the VPS (written by the deploy workflow from GitHub secrets). Never commit real values.
DOMAIN=radio.example.org
IMAGE_TAG=latest
RTMP_BIND=0.0.0.0
RTMP_PORT=1935
RELAY_API_TOKEN=
METRICS_BEARER_TOKEN=
DELAY_SECONDS=0
DELAY_MAX_SECONDS=60
# Shared secret for the API's internal hooks (MediaMTX auth/ready, nginx-rtmp publish check).
HOOK_SECRET=
# MediaMTX ingest (plan S1). Off until COMPOSE_PROFILES=mediamtx; listens on its own port meanwhile.
# COMPOSE_PROFILES=mediamtx
MEDIAMTX_RTMP_BIND=127.0.0.1
MEDIAMTX_RTMP_PORT=1936
# Public ingest for phones (README "Publishing from a phone"). Off by default.
# RTMPS_ENABLED=on turns on RTMPS (TLS) in MediaMTX; it needs rtmps.crt and rtmps.key in RTMPS_CERT_DIR.
# SRT_ENABLED=on turns on SRT (UDP). Both are written to .env as MTX_RTMPENCRYPTION / MTX_SRT by the workflow.
# RTMPS_ENABLED=on
# SRT_ENABLED=on
# Loopback by default; set 0.0.0.0 only when the host firewall allows the port.
RTMPS_BIND=127.0.0.1
RTMPS_PORT=1937
SRT_BIND=127.0.0.1
SRT_PORT=8890
# Directory holding rtmps.crt and rtmps.key, mounted read-only at /certs in the mediamtx container.
# RTMPS_CERT_DIR=./certs
# RADIO_SOURCE_URL_TEMPLATE=rtsp://mediamtx:8554/live/{name}
