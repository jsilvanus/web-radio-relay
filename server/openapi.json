{
  "openapi": "3.1.0",
  "info": {
    "title": "Web radio relay API",
    "version": "1.1.0",
    "description": "Audio-only web radio relay: live status, server-side listener delay, timed captions and archive. Public routes are for listeners and the embeddable widget. Routes under /api/v1 are control routes and need a Bearer token (RELAY_API_TOKEN). Several streams are supported: use /api/streams/{name} (public) and /api/v1/streams/{name} (control). Routes without a name are legacy and serve the default stream."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "live",
          "streamUrl",
          "liveStreamUrl",
          "delaySeconds",
          "lastUpdated"
        ],
        "properties": {
          "live": {
            "type": "boolean"
          },
          "streamUrl": {
            "type": "string",
            "description": "Playlist listeners should load (delayed)."
          },
          "liveStreamUrl": {
            "type": "string",
            "description": "Undelayed playlist, for operators."
          },
          "delaySeconds": {
            "type": "integer",
            "minimum": 0
          },
          "lastUpdated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CaptionInput": {
        "type": "object",
        "required": [
          "lang",
          "text",
          "startedAt"
        ],
        "properties": {
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[a-z0-9]{1,8})*$",
            "description": "BCP 47 language tag, e.g. fi, sv, en."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startedAt": {
            "type": "integer",
            "description": "Epoch milliseconds of the spoken audio on the sender clock (NTP-synced)."
          },
          "endedAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Epoch milliseconds, not before startedAt."
          }
        }
      },
      "Caption": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CaptionInput"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "CaptionList": {
        "type": "object",
        "required": [
          "serverTime",
          "delaySeconds",
          "next",
          "captions"
        ],
        "properties": {
          "serverTime": {
            "type": "integer",
            "description": "Relay clock, epoch milliseconds."
          },
          "delaySeconds": {
            "type": "integer"
          },
          "next": {
            "type": "integer",
            "description": "Pass as ?from= on the next poll."
          },
          "captions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Caption"
            }
          }
        }
      },
      "Delay": {
        "type": "object",
        "required": [
          "delaySeconds",
          "maxSeconds"
        ],
        "properties": {
          "delaySeconds": {
            "type": "integer",
            "minimum": 0
          },
          "maxSeconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SessionEvent": {
        "type": "object",
        "required": [
          "event",
          "streamName"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ]
          },
          "streamName": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlayEvent": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "live-play",
              "archive-play"
            ]
          },
          "filename": {
            "type": "string",
            "description": "Required for archive-play."
          }
        }
      },
      "StreamLifecycle": {
        "type": "object",
        "required": [
          "name",
          "desiredState",
          "state",
          "live"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "desiredState": {
            "enum": [
              "stopped",
              "running"
            ]
          },
          "state": {
            "enum": [
              "stopped",
              "starting",
              "running",
              "stopping",
              "failed"
            ]
          },
          "sourceConfigured": {
            "type": "boolean"
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastTransitionAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "restartCount": {
            "type": "integer"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "live": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "[default stream] Whether the stream is live, and the delay",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/archive": {
      "get": {
        "operationId": "listArchive",
        "summary": "Archived recordings, newest first",
        "responses": {
          "200": {
            "description": "Recordings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "operationId": "getStats",
        "summary": "Aggregate anonymous statistics",
        "responses": {
          "200": {
            "description": "Statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/event": {
      "post": {
        "operationId": "recordPlayEvent",
        "summary": "Record a play event from the widget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded"
          },
          "400": {
            "description": "Invalid event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/hls/delayed.m3u8": {
      "get": {
        "operationId": "getDelayedPlaylist",
        "summary": "[default stream] Live audio playlist, delayed by the relay",
        "responses": {
          "200": {
            "description": "HLS media playlist",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Stream is not live"
          },
          "503": {
            "description": "Stream timing is not available"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/captions": {
      "get": {
        "operationId": "listCaptions",
        "summary": "[default stream] Captions that are due for listeners now",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Epoch ms; use the previous response's next.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Captions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid from",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        }
      }
    },
    "/api/v1/captions": {
      "post": {
        "operationId": "publishCaptions",
        "summary": "[default stream] Push timed captions (and translations) for the stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segments"
                ],
                "properties": {
                  "segments": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/CaptionInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body; the message names the field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          },
          "503": {
            "description": "RELAY_API_TOKEN not set"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/v1/delay": {
      "get": {
        "operationId": "getDelay",
        "summary": "[default stream] Read the listener delay",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delay"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      },
      "put": {
        "operationId": "setDelay",
        "summary": "[default stream] Set the listener delay (applies to audio and captions)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "delaySeconds"
                ],
                "properties": {
                  "delaySeconds": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delay set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delay"
                }
              }
            }
          },
          "400": {
            "description": "Out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/v1/stats/session": {
      "post": {
        "operationId": "recordStreamSession",
        "summary": "Record a stream session start or end",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded"
          },
          "400": {
            "description": "Invalid event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        }
      }
    },
    "/api/streams": {
      "get": {
        "operationId": "listStreams",
        "summary": "Every stream the relay knows, with live state and delay",
        "responses": {
          "200": {
            "description": "Streams",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "streams": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/streams/{name}/status": {
      "get": {
        "operationId": "getStreamStatus",
        "summary": "Live state and delay of one stream",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/api/streams/{name}/hls/delayed.m3u8": {
      "get": {
        "operationId": "getStreamDelayedPlaylist",
        "summary": "Live audio playlist of one stream, delayed by the relay",
        "responses": {
          "200": {
            "description": "HLS media playlist",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Stream is not live"
          },
          "503": {
            "description": "Stream timing is not available"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/api/streams/{name}/captions": {
      "get": {
        "operationId": "listStreamCaptions",
        "summary": "Captions of one stream that are due now",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Epoch ms; use the previous response's next.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Captions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid from",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead."
      }
    },
    "/api/v1/streams/{name}/captions": {
      "post": {
        "operationId": "publishStreamCaptions",
        "summary": "Push timed captions for one stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segments"
                ],
                "properties": {
                  "segments": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/CaptionInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body; the message names the field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          },
          "503": {
            "description": "RELAY_API_TOKEN not set"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/api/v1/streams/{name}/delay": {
      "get": {
        "operationId": "getStreamDelay",
        "summary": "Read the delay of one stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delay"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      },
      "put": {
        "operationId": "setStreamDelay",
        "summary": "Set the delay of one stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "delaySeconds"
                ],
                "properties": {
                  "delaySeconds": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delay set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delay"
                }
              }
            }
          },
          "400": {
            "description": "Out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        },
        "deprecated": true,
        "description": "Legacy route for the default stream. Use the /api/streams/{name} route instead.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Stream name (the RTMP stream key), a-z 0-9 _ - up to 32 characters.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/api/v1/streams/{name}/start": {
      "post": {
        "operationId": "startManagedStream",
        "summary": "Start pulling a configured source for a stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Start accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stream": {
                      "$ref": "#/components/schemas/StreamLifecycle"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid stream name"
          },
          "401": {
            "description": "Missing or wrong token"
          },
          "503": {
            "description": "Source not configured or relay unavailable"
          }
        }
      }
    },
    "/api/v1/streams/{name}/stop": {
      "post": {
        "operationId": "stopManagedStream",
        "summary": "Stop a managed stream and finalize its archive",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stopped",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stream": {
                      "$ref": "#/components/schemas/StreamLifecycle"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid stream name"
          },
          "401": {
            "description": "Missing or wrong token"
          }
        }
      }
    },
    "/api/v1/streams/{name}/lifecycle": {
      "get": {
        "operationId": "getManagedStreamLifecycle",
        "summary": "Get desired and observed lifecycle state",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lifecycle state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stream": {
                      "$ref": "#/components/schemas/StreamLifecycle"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        }
      }
    },
    "/api/v1/captions/source": {
      "get": {
        "operationId": "getCaptionSource",
        "summary": "Status of the pigateway caption pull",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Caption source status (configured is false when GATEWAY_EVENTS_URL is unset)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "captionSource": {
                      "type": "object",
                      "properties": {
                        "configured": { "type": "boolean" },
                        "connected": { "type": "boolean" },
                        "lastEventAt": { "type": ["integer", "null"], "description": "Epoch milliseconds of the last transcript event" },
                        "received": { "type": "integer" },
                        "rejected": { "type": "integer" },
                        "deduped": { "type": "integer" },
                        "reconnects": { "type": "integer" },
                        "lastError": { "type": ["string", "null"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        }
      }
    },    "/api/v1/streams/lifecycle": {
      "get": {
        "operationId": "listManagedStreamLifecycles",
        "summary": "List managed stream lifecycle states",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lifecycle states",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "streams": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StreamLifecycle"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token"
          }
        }
      }
    }
  }
}
